# Beispielwerte – echte Werte nur im Portainer-Stack bzw. in einer lokalen .env (nicht einchecken)
STACK=fernblick-planer
IMAGE=ghcr.io/<owner>/fernblick-planer
IMAGE_TAG=sha-<commit>
PLANER_HOST=planer.example.org
DATEN_PFAD=/srv/fernblick-planer
# Containername oder IP des Reverse-Proxys, nur von dort wird Remote-User akzeptiert
TRUSTED_PROXIES=traefik
TRAEFIK_NETWORK=traefik
TRAEFIK_CERTRESOLVER=letsencrypt
# Forward-Auth (z. B. Authelia) und weitere Middlewares für die Oberfläche
TRAEFIK_MIDDLEWARES_WEB=authelia@file
# optional für die öffentlichen Pfade (MCP, OAuth), z. B. Rate-Limit
TRAEFIK_MIDDLEWARES_PUBLIC=
# Benutzer mit Zugriff (Komma-getrennt), leer = alle angemeldeten
ALLOWED_USERS=
RENDER_CPUS=5
RENDER_THREADS=5
